{"probe":"page.landing","kind":"page","concept":"landing","model":"gpt-6.2","family":"openai","sample":0,"raw":"<body>\n  <main>\n    <ui-hero>\n      <h1>Make room for your best ideas</h1>\n      <p>Capture quick thoughts, organize project notes, and find what you wrote when you need it.</p>\n      <ui-button variant=\"primary\" href=\"/signup\">Start for free</ui-button>\n      <ui-button variant=\"secondary\" href=\"#features\">Explore features</ui-button>\n    </ui-hero>\n\n    <ui-section id=\"features\" aria-labelledby=\"features-heading\">\n      <h2 id=\"features-heading\">From quick thoughts to finished plans</h2>\n      <ui-grid columns=\"3\" gap=\"large\">\n        <ui-card>\n          <ui-icon name=\"zap\" aria-hidden=\"true\"></ui-icon>\n          <h3>Quick capture</h3>\n          <p>Jot down an idea, a reminder, or a meeting note in seconds.</p>\n        </ui-card>\n        <ui-card>\n          <ui-icon name=\"folder\" aria-hidden=\"true\"></ui-icon>\n          <h3>Notebooks and tags</h3>\n          <p>Group notes by project and tag ideas that span several notebooks.</p>\n        </ui-card>\n        <ui-card>\n          <ui-icon name=\"search\" aria-hidden=\"true\"></ui-icon>\n          <h3>Full-text search</h3>\n          <p>Find a note with a phrase you remember from writing it.</p>\n        </ui-card>\n        <ui-card>\n          <ui-icon name=\"check-square\" aria-hidden=\"true\"></ui-icon>\n          <h3>Checklists</h3>\n          <p>Turn meeting notes into tasks and check them off as you go.</p>\n        </ui-card>\n        <ui-card>\n          <ui-icon name=\"refresh-cw\" aria-hidden=\"true\"></ui-icon>\n          <h3>Device sync</h3>\n          <p>Start a note on your phone and pick it up on your laptop.</p>\n        </ui-card>\n        <ui-card>\n          <ui-icon name=\"share-2\" aria-hidden=\"true\"></ui-icon>\n          <h3>Shared notebooks</h3>\n          <p>Keep project notes and decisions where everyone can find them.</p>\n        </ui