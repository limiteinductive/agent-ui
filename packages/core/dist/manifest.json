{
  "version": "0.1.0",
  "elements": {
    "ui-stack": {
      "description": "Vertical flow with consistent gaps. `direction=\"horizontal\"` makes it exactly a `ui-row`.",
      "attrs": {
        "gap": {
          "kind": "scale",
          "values": [
            "0",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "default": "md",
          "description": "Space between children."
        },
        "align": {
          "kind": "enum",
          "values": [
            "start",
            "center",
            "end",
            "stretch",
            "baseline"
          ],
          "default": "stretch",
          "valueAliases": {
            "left": "start",
            "right": "end",
            "flex-start": "start",
            "flex-end": "end"
          },
          "description": "Cross-axis alignment of children."
        },
        "justify": {
          "kind": "enum",
          "values": [
            "start",
            "center",
            "end",
            "space-between"
          ],
          "default": "start",
          "valueAliases": {
            "between": "space-between",
            "flex-start": "start",
            "flex-end": "end",
            "left": "start",
            "right": "end"
          },
          "description": "Main-axis distribution. `space-between` with 2 children pushes them apart; with 3 it gives start / true center / end."
        },
        "padding": {
          "kind": "scale",
          "values": [
            "0",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "default": "0",
          "description": "Inner spacing."
        },
        "direction": {
          "kind": "enum",
          "values": [
            "vertical",
            "horizontal"
          ],
          "default": "vertical",
          "valueAliases": {
            "row": "horizontal",
            "column": "vertical"
          },
          "description": "`horizontal` = `ui-row` (all row attributes apply)."
        },
        "wrap": {
          "kind": "toggle",
          "description": "Children wrap onto new lines (tags, chips, button groups). Off by default.",
          "requires": {
            "attr": "direction",
            "value": "horizontal",
            "hint": "row attribute on a vertical ui-stack"
          }
        },
        "scroll": {
          "kind": "toggle",
          "on": [
            "x",
            "horizontal"
          ],
          "description": "Horizontal rail: one line that scrolls, with snap. Pair with `item-width` for card carousels.",
          "requires": {
            "attr": "direction",
            "value": "horizontal",
            "hint": "row attribute on a vertical ui-stack"
          }
        },
        "equal": {
          "kind": "toggle",
          "description": "Children share the row equally (`flex: 1 1 0`).",
          "requires": {
            "attr": "direction",
            "value": "horizontal",
            "hint": "row attribute on a vertical ui-stack"
          }
        },
        "stack-below": {
          "kind": "scale",
          "values": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "presence": "md",
          "length": true,
          "cssVar": "--_threshold",
          "tokens": "measure",
          "description": "All-or-nothing switch: below this container width every child stacks; above it they share one line equally.",
          "requires": {
            "attr": "direction",
            "value": "horizontal",
            "hint": "row attribute on a vertical ui-stack"
          }
        },
        "limit": {
          "kind": "int",
          "min": 2,
          "max": 6,
          "description": "With `stack-below`: stack anyway when there are more than N children.",
          "requires": {
            "attr": "direction",
            "value": "horizontal",
            "hint": "row attribute on a vertical ui-stack"
          }
        },
        "item-width": {
          "kind": "scale",
          "values": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "length": true,
          "cssVar": "--_item",
          "tokens": "item",
          "description": "With `scroll`: width of each item (capped at 85% of the rail).",
          "requires": {
            "attr": "direction",
            "value": "horizontal",
            "hint": "row attribute on a vertical ui-stack"
          }
        }
      },
      "attrAliases": {
        "horizontal": {
          "to": "direction",
          "value": "horizontal"
        },
        "vertical": {
          "to": "direction",
          "value": "vertical"
        },
        "scrollable": {
          "to": "scroll"
        },
        "overflow": {
          "to": "scroll",
          "values": {
            "scroll": "",
            "auto": ""
          }
        },
        "threshold": {
          "to": "stack-below"
        },
        "breakpoint": {
          "to": "stack-below"
        },
        "collapse-at": {
          "to": "stack-below"
        },
        "stack-at": {
          "to": "stack-below"
        },
        "wrap-below": {
          "to": "stack-below"
        },
        "collapse": {
          "to": "stack-below"
        },
        "equal-width": {
          "to": "equal"
        },
        "max-items": {
          "to": "limit"
        },
        "card-width": {
          "to": "item-width"
        }
      },
      "conflicts": [
        [
          "scroll",
          "wrap"
        ],
        [
          "scroll",
          "stack-below"
        ]
      ],
      "childAttrs": [
        "grow"
      ]
    },
    "ui-row": {
      "description": "Horizontal line of children. Content-sized, no wrap, vertically centered by default.",
      "attrs": {
        "gap": {
          "kind": "scale",
          "values": [
            "0",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "default": "md",
          "description": "Space between children."
        },
        "align": {
          "kind": "enum",
          "values": [
            "start",
            "center",
            "end",
            "stretch",
            "baseline"
          ],
          "default": "center",
          "valueAliases": {
            "left": "start",
            "right": "end",
            "flex-start": "start",
            "flex-end": "end"
          },
          "description": "Cross-axis alignment of children."
        },
        "justify": {
          "kind": "enum",
          "values": [
            "start",
            "center",
            "end",
            "space-between"
          ],
          "default": "start",
          "valueAliases": {
            "between": "space-between",
            "flex-start": "start",
            "flex-end": "end",
            "left": "start",
            "right": "end"
          },
          "description": "Main-axis distribution. `space-between` with 2 children pushes them apart; with 3 it gives start / true center / end."
        },
        "padding": {
          "kind": "scale",
          "values": [
            "0",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "default": "0",
          "description": "Inner spacing."
        },
        "wrap": {
          "kind": "toggle",
          "description": "Children wrap onto new lines (tags, chips, button groups). Off by default."
        },
        "scroll": {
          "kind": "toggle",
          "on": [
            "x",
            "horizontal"
          ],
          "description": "Horizontal rail: one line that scrolls, with snap. Pair with `item-width` for card carousels."
        },
        "equal": {
          "kind": "toggle",
          "description": "Children share the row equally (`flex: 1 1 0`)."
        },
        "stack-below": {
          "kind": "scale",
          "values": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "presence": "md",
          "length": true,
          "cssVar": "--_threshold",
          "tokens": "measure",
          "description": "All-or-nothing switch: below this container width every child stacks; above it they share one line equally."
        },
        "limit": {
          "kind": "int",
          "min": 2,
          "max": 6,
          "description": "With `stack-below`: stack anyway when there are more than N children."
        },
        "item-width": {
          "kind": "scale",
          "values": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "length": true,
          "cssVar": "--_item",
          "tokens": "item",
          "description": "With `scroll`: width of each item (capped at 85% of the rail)."
        }
      },
      "attrAliases": {
        "scrollable": {
          "to": "scroll"
        },
        "overflow": {
          "to": "scroll",
          "values": {
            "scroll": "",
            "auto": ""
          }
        },
        "threshold": {
          "to": "stack-below"
        },
        "breakpoint": {
          "to": "stack-below"
        },
        "collapse-at": {
          "to": "stack-below"
        },
        "stack-at": {
          "to": "stack-below"
        },
        "wrap-below": {
          "to": "stack-below"
        },
        "collapse": {
          "to": "stack-below"
        },
        "equal-width": {
          "to": "equal"
        },
        "max-items": {
          "to": "limit"
        },
        "card-width": {
          "to": "item-width"
        }
      },
      "conflicts": [
        [
          "scroll",
          "wrap"
        ],
        [
          "scroll",
          "stack-below"
        ]
      ],
      "childAttrs": [
        "grow"
      ]
    },
    "ui-grid": {
      "description": "Equal tiles that reflow: as many columns as fit `min-item-width`. `columns` = exact count, `max-columns` = responsive cap.",
      "attrs": {
        "gap": {
          "kind": "scale",
          "values": [
            "0",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "default": "md",
          "description": "Space between children."
        },
        "padding": {
          "kind": "scale",
          "values": [
            "0",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "default": "0",
          "description": "Inner spacing."
        },
        "min-item-width": {
          "kind": "scale",
          "values": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "default": "md",
          "length": true,
          "cssVar": "--_min",
          "tokens": "item",
          "description": "Smallest a tile may get before the grid drops a column."
        },
        "columns": {
          "kind": "int",
          "min": 1,
          "max": 12,
          "description": "Exact column count at every width (calendars, fixed tables)."
        },
        "max-columns": {
          "kind": "int",
          "min": 1,
          "max": 12,
          "description": "Responsive: at most N columns, fewer when tiles would drop below `min-item-width`."
        }
      },
      "attrAliases": {
        "min": {
          "to": "min-item-width"
        },
        "min-width": {
          "to": "min-item-width"
        },
        "min-column-width": {
          "to": "min-item-width"
        },
        "columns-sm": {
          "to": "max-columns"
        },
        "columns-md": {
          "to": "max-columns"
        },
        "columns-lg": {
          "to": "max-columns"
        },
        "columns-xl": {
          "to": "max-columns"
        }
      },
      "conflicts": [
        [
          "columns",
          "max-columns"
        ]
      ]
    },
    "ui-overlay": {
      "description": "Children share one cell; later children paint on top (badge on image, caption over media).",
      "attrs": {
        "align": {
          "kind": "enum",
          "values": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "default": "stretch",
          "valueAliases": {
            "left": "start",
            "right": "end",
            "flex-start": "start",
            "flex-end": "end"
          },
          "description": "Vertical placement of children."
        },
        "justify": {
          "kind": "enum",
          "values": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "default": "stretch",
          "valueAliases": {
            "left": "start",
            "right": "end",
            "flex-start": "start",
            "flex-end": "end"
          },
          "description": "Horizontal placement of children."
        }
      }
    },
    "ui-card": {
      "description": "Bounded surface. Owns its ink, borders and focus color for everything inside.",
      "attrs": {
        "padding": {
          "kind": "scale",
          "values": [
            "0",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "default": "lg",
          "description": "Inner spacing."
        },
        "gap": {
          "kind": "scale",
          "values": [
            "0",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl"
          ],
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl"
          },
          "default": "md",
          "description": "Space between children."
        },
        "rounded": {
          "kind": "scale",
          "values": [
            "0",
            "sm",
            "md",
            "lg",
            "xl",
            "full"
          ],
          "presence": "md",
          "default": "lg",
          "tokens": "radius",
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl",
            "pill": "full",
            "round": "full"
          },
          "description": "Corner radius."
        },
        "elevated": {
          "kind": "flag",
          "description": "Raised above the page (shadow)."
        },
        "sunken": {
          "kind": "flag",
          "description": "Recessed below the page."
        },
        "inverse": {
          "kind": "flag",
          "description": "Opposite color scheme (dark card on a light page)."
        },
        "variant": {
          "kind": "enum",
          "values": [
            "neutral",
            "primary",
            "success",
            "warning",
            "danger",
            "info"
          ],
          "valueAliases": {
            "accent": "primary",
            "error": "danger",
            "critical": "danger",
            "caution": "warning",
            "positive": "success",
            "sunken": {
              "attr": "sunken"
            },
            "elevated": {
              "attr": "elevated"
            },
            "inverse": {
              "attr": "inverse"
            }
          },
          "description": "Meaning: tints the surface."
        }
      },
      "attrAliases": {
        "pad": {
          "to": "padding"
        },
        "radius": {
          "to": "rounded"
        },
        "tone": {
          "to": "variant"
        },
        "intent": {
          "to": "variant"
        },
        "color": {
          "to": "variant"
        }
      },
      "conflicts": [
        [
          "elevated",
          "sunken",
          "inverse"
        ]
      ],
      "childAttrs": [
        "grow"
      ]
    },
    "ui-button": {
      "description": "Button. Form-associated: `type=\"submit\"` submits its form. Default `type=\"button\"`.",
      "attrs": {
        "variant": {
          "kind": "enum",
          "values": [
            "primary",
            "secondary",
            "outline",
            "ghost",
            "danger"
          ],
          "default": "secondary",
          "valueAliases": {
            "destructive": "danger",
            "accent": "primary",
            "error": "danger"
          },
          "description": "Emphasis."
        },
        "size": {
          "kind": "enum",
          "values": [
            "sm",
            "md",
            "lg"
          ],
          "default": "md",
          "valueAliases": {
            "small": "sm",
            "medium": "md",
            "large": "lg"
          },
          "description": "Height and padding."
        },
        "type": {
          "kind": "enum",
          "values": [
            "button",
            "submit",
            "reset"
          ],
          "default": "button",
          "description": "Form behavior."
        },
        "loading": {
          "kind": "flag",
          "description": "Pending: shows a spinner and ignores clicks."
        },
        "disabled": {
          "kind": "flag",
          "description": "Disabled (stays focusable, announced as disabled)."
        },
        "rounded": {
          "kind": "scale",
          "values": [
            "0",
            "sm",
            "md",
            "lg",
            "full"
          ],
          "presence": "full",
          "tokens": "radius",
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl",
            "pill": "full",
            "round": "full"
          },
          "description": "Corner radius; bare `rounded` = pill."
        },
        "name": {
          "kind": "string",
          "description": "Form field name."
        },
        "value": {
          "kind": "string",
          "description": "Form field value."
        }
      },
      "attrAliases": {
        "busy": {
          "to": "loading"
        },
        "pending": {
          "to": "loading"
        },
        "tone": {
          "to": "variant"
        },
        "intent": {
          "to": "variant"
        },
        "color": {
          "to": "variant"
        }
      }
    },
    "ui-page": {
      "description": "Page root. `layout=\"document\"` (default) scrolls the document; `layout=\"app\"` is a full-height shell whose main region scrolls.",
      "attrs": {
        "layout": {
          "kind": "enum",
          "values": [
            "document",
            "app"
          ],
          "default": "document",
          "description": "Document flow or app shell."
        }
      }
    },
    "ui-container": {
      "description": "Centered max-width column with gutters. Children may break out with `bleed=\"wide|full\"`.",
      "attrs": {
        "size": {
          "kind": "scale",
          "values": [
            "sm",
            "md",
            "lg",
            "xl",
            "full"
          ],
          "default": "lg",
          "tokens": "container",
          "valueAliases": {
            "none": "0",
            "small": "sm",
            "medium": "md",
            "large": "lg",
            "xxl": "2xl",
            "narrow": "sm",
            "wide": "xl"
          },
          "description": "Content width."
        }
      },
      "attrAliases": {
        "width": {
          "to": "size"
        },
        "max-width": {
          "to": "size"
        }
      },
      "childAttrs": [
        "bleed"
      ]
    }
  },
  "childAttrs": {
    "grow": {
      "kind": "toggle",
      "parents": [
        "ui-stack",
        "ui-row",
        "ui-card"
      ],
      "description": "This child takes the leftover space. In a wrapping row it becomes the main column of a side + main layout."
    },
    "bleed": {
      "kind": "enum",
      "values": [
        "wide",
        "full"
      ],
      "presence": "full",
      "parents": [
        "ui-container"
      ],
      "description": "Escape the container measure: `wide` or edge-to-edge `full`."
    }
  },
  "tagAliases": {
    "ui-panel": {
      "to": "ui-card"
    },
    "ui-surface": {
      "to": "ui-card"
    },
    "ui-layers": {
      "to": "ui-overlay"
    },
    "ui-app": {
      "to": "ui-page"
    },
    "ui-layout": {
      "to": "ui-page",
      "attrs": {
        "layout": "app"
      }
    },
    "ui-shell": {
      "to": "ui-page",
      "attrs": {
        "layout": "app"
      }
    },
    "ui-app-shell": {
      "to": "ui-page",
      "attrs": {
        "layout": "app"
      }
    }
  },
  "preferNative": {
    "ui-link": {
      "use": "<a href=\"…\">",
      "display": "inline"
    },
    "ui-list": {
      "use": "<ul> or <ol>",
      "display": "block"
    },
    "ui-list-item": {
      "use": "<li>",
      "display": "block"
    }
  },
  "planned": {
    "ui-heading": "<h1>…<h6> (styled automatically)",
    "ui-text": "<p> or <span>; <small> for fine print",
    "ui-table": "<table> with <thead>/<tbody> (styled automatically)",
    "ui-input": "<label>Label <input name=\"…\"></label>",
    "ui-switch": "<input type=\"checkbox\" role=\"switch\">",
    "ui-checkbox": "<input type=\"checkbox\">",
    "ui-select": "<select>",
    "ui-field": "<label> wrapping the control",
    "ui-dialog": "<dialog>",
    "ui-alert": "<ui-card variant=\"warning|danger|info|success\" role=\"status\">",
    "ui-divider": "<hr>",
    "ui-badge": "<span> (or <mark>)",
    "ui-icon": "inline <svg>",
    "ui-prose": "plain <div> (native text is styled)",
    "ui-aspect-ratio": "<div style=\"aspect-ratio: 16 / 9\">",
    "ui-scroll-area": "<div style=\"overflow: auto\">",
    "ui-relative-time": "<time datetime=\"…\">",
    "ui-date": "<time datetime=\"…\">",
    "ui-datetime": "<time datetime=\"…\">",
    "ui-number": "the formatted number as text",
    "ui-stat": "<ui-card> with <ui-stack gap=\"xs\"> (label, value, change)",
    "ui-avatar": "<img alt=\"…\">",
    "ui-skeleton": "nothing (render the content)"
  },
