        {
          "name": "wrap",
          "description": {
            "kind": "markdown",
            "value": "Children wrap onto new lines (tags, chips, button groups). Off by default."
          },
          "valueSet": "v"
        },
        {
          "name": "scroll",
          "description": {
            "kind": "markdown",
            "value": "Horizontal rail: one line that scrolls, with snap. Pair with `item-width` for card carousels."
